# ============================================================================
# hmdp 服务器环境变量配置（被 scripts/start-server.sh 自动加载）
# 用法：复制为 .env 并填写真实值；.env 已被 gitignore 忽略，不会泄露
# ============================================================================

# 数据库
DB_USERNAME=hmdp
DB_PASSWORD='hmdp@123456'

# Redis
REDIS_PASSWORD='4d05a61de1d44594b2e0bf45facda0b3'

# 验证码通道：log（验证码进日志/Redis）或 email（真实发送邮件）
VERIFY_CODE_CHANNEL=log

# 邮箱配置（VERIFY_CODE_CHANNEL=email 时必填）
# QQ邮箱获取方式：设置 → 账号 → 开启 SMTP 服务 → 生成授权码
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 飞书告警（可选）：飞书群 → 设置 → 群机器人 → 添加「自定义机器人」→ 复制 webhook 地址
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx

# Kafka 消费并发（须 <= seckill-order topic 分区数；分区8/并发8）
KAFKA_CONSUMER_CONCURRENCY=8
